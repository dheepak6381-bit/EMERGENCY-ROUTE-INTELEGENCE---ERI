rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ────────────────────────────────────────────────────────────────────────
    // ERI Security Rules — Anonymous-Auth-Gated Writes
    //
    // Reads are open so the dashboard can stream hospitals and road
    // conditions without requiring auth on every page load.
    //
    // Writes require Firebase Anonymous Authentication, which the app
    // obtains on startup via FirebaseAuth.instance.signInAnonymously().
    // This closes the wide-open anonymous write hole that existed before.
    //
    // TODO (Production): Upgrade to role-based auth with custom claims
    // (e.g. request.auth.token.role == 'dispatcher') for full production
    // security. Anonymous auth is sufficient for the SIH demo but is not
    // production-grade access control.
    // ────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
