rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ────────────────────────────────────────────────────────────────────────
    // ERI Demo Rules — OPEN READ/WRITE FOR HACKATHON
    // This allows the browser to read and write without auth for CIC26 demo.
    // 
    // TODO (Production):
    // In a real-world deployment, this must be locked down to authenticated 
    // dispatchers. Example production rules:
    //
    // match /{document=**} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null && request.auth.token.role == 'dispatcher';
    // }
    // ────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
